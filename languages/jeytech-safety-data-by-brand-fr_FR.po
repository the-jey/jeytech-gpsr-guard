#. Plugin Name of the plugin
#: jeytech-safety-data-by-brand.php
msgid "JeyTech Safety Data by Brand for WooCommerce"
msgstr "JeyTech Safety Data by Brand for WooCommerce"

#. Description of the plugin
#: jeytech-safety-data-by-brand.php
msgid ""
"Add GPSR manufacturer and safety information to every product — set it once "
"per brand, audit what's missing."
msgstr ""
"Ajoutez les informations GPSR (fabricant, responsable UE, sécurité) à tous "
"vos produits, renseignées une fois par marque."

