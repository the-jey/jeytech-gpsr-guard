{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"landingPage": "/wp-admin/admin.php?page=jeytech-sdbb",
	"steps": [
		{ "step": "login", "username": "admin", "password": "password" },
		{ "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
		{ "step": "wp-cli", "command": "wp wc hpos enable" },
		{ "step": "wp-cli", "command": "wp language core install fr_FR --activate" },
		{ "step": "wp-cli", "command": "wp language plugin install woocommerce fr_FR" },
		{ "step": "cp", "fromPath": "/wordpress/wp-content/plugins/jeytech-safety-data-by-brand/languages/jeytech-safety-data-by-brand-fr_FR.mo", "toPath": "/wordpress/wp-content/languages/plugins/jeytech-safety-data-by-brand-fr_FR.mo" },
		{ "step": "cp", "fromPath": "/wordpress/wp-content/plugins/jeytech-safety-data-by-brand/languages/jeytech-safety-data-by-brand-fr_FR.l10n.php", "toPath": "/wordpress/wp-content/languages/plugins/jeytech-safety-data-by-brand-fr_FR.l10n.php" },
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Boutique démo JeyTech",
				"woocommerce_currency": "EUR",
				"woocommerce_default_country": "FR",
				"woocommerce_task_list_hidden": "yes",
				"woocommerce_onboarding_profile": { "skipped": true }
			}
		},
		{ "step": "activatePlugin", "pluginPath": "jeytech-safety-data-by-brand/jeytech-safety-data-by-brand.php" },
		{ "step": "wp-cli", "command": "wp eval-file /wordpress/wp-content/plugins/jeytech-safety-data-by-brand/dev/seed.php" }
	]
}
