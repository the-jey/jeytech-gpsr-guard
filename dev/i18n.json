{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"steps": [
		{ "step": "wp-cli", "command": "wp i18n make-pot /wordpress/wp-content/plugins/jeytech-gpsr-guard /wordpress/wp-content/plugins/jeytech-gpsr-guard/languages/jeytech-gpsr-guard.pot --slug=jeytech-gpsr-guard --domain=jeytech-gpsr-guard --exclude=dev,bin,node_modules,dist,.wordpress-org" },
		{ "step": "wp-cli", "command": "wp i18n make-mo /wordpress/wp-content/plugins/jeytech-gpsr-guard/languages" },
		{ "step": "wp-cli", "command": "wp i18n make-php /wordpress/wp-content/plugins/jeytech-gpsr-guard/languages" }
	]
}
